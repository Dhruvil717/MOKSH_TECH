# Choose one provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Only the key for the provider you choose is required
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GROQ_API_KEY=
GROQ_MODEL=

# How many leads to research concurrently (I/O bound, keep modest for free-tier rate limits)
MAX_WORKERS=3

# Max number of internal pages (in addition to the homepage) to crawl per lead
MAX_PAGES_PER_LEAD=3

# HTTP request timeout in seconds
REQUEST_TIMEOUT=12

# SQLite database file
DATABASE_PATH=data/leads.db
